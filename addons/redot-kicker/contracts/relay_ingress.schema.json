        "Kick-Event-Subscription-Id": {"type": "string", "minLength": 1, "maxLength": 128},
        "Kick-Event-Signature": {"type": "string", "minLength": 1, "maxLength": 8192},
        "Kick-Event-Message-Timestamp": {"type": "string", "format": "date-time", "maxLength": 64},
        "Kick-Event-Type": {"type": "string", "minLength": 1, "maxLength": 128},
