  "events": [
    {"type":"chat.message.sent","version":1,"scope":"events:subscribe"},
    {"type":"channel.followed","version":1,"scope":"events:subscribe"},
    {"type":"channel.subscription.renewal","version":1,"scope":"events:subscribe"},
    {"type":"channel.subscription.gifts","version":1,"scope":"events:subscribe"},
    {"type":"channel.subscription.new","version":1,"scope":"events:subscribe"},
    {"type":"channel.reward.redemption.updated","version":1,"scope":"events:subscribe"},
