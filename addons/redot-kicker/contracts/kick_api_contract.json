    {"id":"categories.search.v1","method":"GET","path":"/public/v1/categories","scopes":[],"token_kinds":["user","app"],"state":"deprecated"},
    {"id":"categories.get.v1","method":"GET","path":"/public/v1/categories/{category_id}","scopes":[],"token_kinds":["user","app"],"state":"deprecated"},
