    {"id":"public_key.get","method":"GET","path":"/public/v1/public-key","scopes":[],"token_kinds":["none"],"state":"supported"},
    {"id":"token.introspect","method":"POST","path":"/oauth/token/introspect","scopes":[],"token_kinds":["user","app"],"state":"supported"},
    {"id":"users.get","method":"GET","path":"/public/v1/users","scopes":["user:read"],"token_kinds":["user","app"],"state":"supported"},
    {"id":"stream_key.get","method":"GET","path":"","scopes":["streamkey:read"],"token_kinds":["user"],"state":"scope_declared_route_unavailable"}
