    {"id":"channels.update","method":"PATCH","path":"/public/v1/channels","scopes":["channel:write"],"token_kinds":["user"],"state":"supported"},
    {"id":"rewards.list","method":"GET","path":"/public/v1/channels/rewards","scopes":["channel:rewards:read","channel:rewards:write"],"scope_mode":"any","token_kinds":["user"],"state":"supported"},
    {"id":"rewards.create","method":"POST","path":"/public/v1/channels/rewards","scopes":["channel:rewards:write"],"token_kinds":["user"],"state":"supported"},
