    {"id":"livestreams.list.v2","method":"GET","path":"/public/v2/livestreams","scopes":[],"token_kinds":["user","app"],"state":"supported"},
    {"id":"livestreams.list.v1","method":"GET","path":"/public/v1/livestreams","scopes":[],"token_kinds":["user","app"],"state":"deprecated"},
