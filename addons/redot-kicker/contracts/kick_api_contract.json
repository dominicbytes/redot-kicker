  "data_lifecycle": [
    {"id":"kick_client_secret","storage":"relay_vault_only","desktop_plaintext":false},
    {"id":"kick_access_token","storage":"relay_vault_only","desktop_plaintext":false},
    {"id":"kick_refresh_token","storage":"relay_vault_only","desktop_plaintext":false},
    {"id":"broker_session_credential","storage":"desktop_os_vault_only","desktop_plaintext":false},
    {"id":"session_descriptor","storage":"desktop_user_non_secret","desktop_plaintext":true},
    {"id":"webhook_raw_body","storage":"relay_memory_until_dispatch","desktop_plaintext":false},
    {"id":"replay_identity","storage":"relay_bounded_ttl","desktop_plaintext":false}
